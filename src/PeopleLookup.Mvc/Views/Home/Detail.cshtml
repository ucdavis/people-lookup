@model PeopleLookup.Mvc.Models.SearchResult

@{
    ViewData["Title"] = "User lookup details";
}

@if (Model == null || Model.Found == false)
{
    <div class="card">
        <div class="card-header">
            <h2>@ViewBag.Title</h2>
        </div>
        <div class="card-body">
            <h3 style="color:red">User Not Found</h3>
            <small class="form-text text-muted">This may be because the user is no longer active in the campus system, or the email used isn't in the campus IAM system.</small>
            @if(Model != null && !string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <small class="form-text text-muted">@Model.ErrorMessage</small>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h2>@ViewBag.Title</h2>
        </div>
        <div class="card-body">
            <div>
                <dl class="row detail-fields">
                    <dt class="col-sm-2">
                        Name
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.FullName)
                    </dd>
                    @if(ViewBag.AllowSensitiveInfo == true)
                    {
                        <dt class="col-sm-2">
                            Official Full Name
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.O_FullName)
                        </dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Pronouns))
                    {
                    <dt class="col-sm-2">
                        Pronouns
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Pronouns)
                    </dd>
                    }
                    @if (ViewBag.AllowSensitiveInfo == true)
                    {
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.KerbId)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.KerbId)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.IamId)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.IamId)
                        </dd>
                    }
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Email)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Email)
                    </dd>
                    @if(!string.IsNullOrWhiteSpace(Model.OtherEmails))
                    {
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.OtherEmails)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.OtherEmails)
                        </dd>
                    }
                    @if (ViewBag.AllowSensitiveInfo == true)
                    {
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.IsEmployee)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.IsEmployee)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.IsHSEmployee)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.IsHSEmployee)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.IsFaculty)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.IsFaculty)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.IsStudent)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.IsStudent)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.IsExternal)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.IsExternal)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.IsStaff)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.IsStaff)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.PpsId)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.PpsId)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.StudentId)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.StudentId)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.BannerPidm)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.BannerPidm)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.EmployeeId)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.EmployeeId)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.MothraId)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.MothraId)
                        </dd>
                    }
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Title)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Title)
                    </dd>
                    @if (ViewBag.AllowSensitiveInfo == true)
                    {
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ReportsToIamId)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.ReportsToIamId)
                        </dd>
                    }
                    <dt class="col-sm-2">
                        Affiliation
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.ExpandedAffiliation)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Departments)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Departments)
                    </dd>
                    <dt class="col-sm-2">
                        Work Phone
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.WorkPhone)
                    </dd>
                </dl>
            </div>
        </div>
    </div>
}

@section Scripts
{
    <script type="text/javascript">
        $(function () {
            var defaultTooltipMessage = "copy to clipboard";
            var copyIconSvg = '<span class="copy-detail-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path fill="currentColor" d="M16 1H6C4.9 1 4 1.9 4 3V17H6V3H16V1ZM19 5H10C8.9 5 8 5.9 8 7V21C8 22.1 8.9 23 10 23H19C20.1 23 21 22.1 21 21V7C21 5.9 20.1 5 19 5ZM19 21H10V7H19V21Z"></path></svg></span>';

            function setTooltipText($button, text) {
                $button.attr("title", text);
                $button.attr("data-original-title", text);
            }

            function copyText(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    return navigator.clipboard.writeText(text);
                }

                return new Promise(function (resolve, reject) {
                    var textArea = document.createElement("textarea");
                    textArea.value = text;
                    textArea.setAttribute("readonly", "");
                    textArea.style.position = "fixed";
                    textArea.style.top = "-9999px";

                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();

                    try {
                        if (document.execCommand("copy")) {
                            resolve();
                        } else {
                            reject(new Error("Copy command was unsuccessful."));
                        }
                    } catch (error) {
                        reject(error);
                    } finally {
                        document.body.removeChild(textArea);
                    }
                });
            }

            $(".detail-fields dd").each(function () {
                var $field = $(this);
                var copyValue = $.trim($field.text());

                if (!copyValue) {
                    return;
                }

                var $text = $("<span />", { "class": "copy-detail-text" });
                $text.append($field.contents());

                var $button = $("<button />", {
                    type: "button",
                    "class": "btn btn-link copy-detail-button",
                    "aria-label": "Copy to clipboard",
                    title: defaultTooltipMessage,
                    "data-original-title": defaultTooltipMessage,
                    html: copyIconSvg
                });

                $button.tooltip({
                    placement: "top",
                    trigger: "hover focus"
                });

                $button.on("click", function (event) {
                    event.preventDefault();

                    copyText(copyValue)
                        .then(function () {
                            setTooltipText($button, "copied!");
                            $button.tooltip("show");

                            window.clearTimeout($button.data("copy-reset-timer"));
                            $button.data("copy-reset-timer", window.setTimeout(function () {
                                setTooltipText($button, defaultTooltipMessage);
                                $button.tooltip("hide");
                            }, 2000));
                        })
                        .catch(function () {
                            setTooltipText($button, "copy failed");
                            $button.tooltip("show");
                        });
                });

                $button.on("blur", function () {
                    if ($button.attr("data-original-title") !== "copied!") {
                        setTooltipText($button, defaultTooltipMessage);
                    }
                });

                $field.empty().append(
                    $("<span />", { "class": "copy-detail-wrap" })
                        .append($text)
                        .append($button)
                );
            });
        });
    </script>
}
